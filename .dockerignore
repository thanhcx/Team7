# --- Version control & repo metadata ---
.git
.gitignore
.gitattributes

# --- Python caches & virtual envs ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
*.egg-info/
.mypy_cache/
.ruff_cache/

# --- Tests & dev-only scripts (not needed at runtime) ---
tests/
scripts/
test_greennode.py
test.txt

# --- AgentBase skills: dev tooling (SKILL.md for AI coding agents),
#     NOT runtime code. Excluding keeps the image lean and avoids shipping
#     helper bash scripts that reference .claude/skills/ paths. ---
agent/skills/

# --- AgentBase local state & secrets (never bake into the image) ---
.agentbase/
.greennode.json
.env
.env.*
!.env.example

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
