# ----------------------------------------------------------------------------
# Environment variables for the I&O Operations Support Agent
# Copy to `.env` for local runs. For AgentBase deployment, set the LLM key
# via the runtime's env config (or store it with /agentbase-identity and let
# the platform inject it) — do NOT bake secrets into the Docker image.
# ----------------------------------------------------------------------------

# ---- LLM (GreenNode MaaS, OpenAI-compatible) -------------------------------
# Required for real LLM calls. Leave empty for dry-run / evidence-only mode.
GREENNODE_API_KEY=

# Base URL of the GreenNode MaaS endpoint (built-in default shown).
GREENNODE_BASE_URL=https://maas-llm-aiplatform-hcm.api.vngcloud.vn/v1

# Model identifier (built-in default shown).
GREENNODE_MODEL=z-ai/glm-5.2-hackathon

# ---- Agent tuning (all have built-in defaults) ----------------------------
AGENT_LLM_TEMPERATURE=0.2
AGENT_LLM_MAX_TOKENS=4096
AGENT_LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# AgentBase auto-injected variables — DO NOT set these manually.
# The AgentBase runtime injects them into the container at deploy time:
#   GREENNODE_CLIENT_ID       — IAM service account (auto-managed)
#   GREENNODE_CLIENT_SECRET   — IAM service account secret (auto-managed)
#   GREENNODE_AGENT_IDENTITY  — agent identity for outbound auth
#   GREENNODE_ENDPOINT_URL    — public URL routing into this container
# ----------------------------------------------------------------------------
